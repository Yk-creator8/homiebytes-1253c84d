# ============ Public (sent to browser) ============
PUBLIC_SUPABASE_URL=http://localhost:8000
SITE_URL=http://localhost

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-byte-hex
REALTIME_SECRET_KEY_BASE=replace-with-64-byte-hex

# Issue JWTs signed with JWT_SECRET (role=anon / role=service_role)
# See DEPLOYMENT.md "Generating ANON_KEY and SERVICE_ROLE_KEY"
ANON_KEY=replace
SERVICE_ROLE_KEY=replace

# ============ Database ============
POSTGRES_PASSWORD=change-me-strong-password

# ============ Integrations (optional — fill as you wire them) ============
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio / MSG91 (OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# Resend (email)
RESEND_API_KEY=

# Firebase Cloud Messaging
FCM_SERVER_KEY=

# PostHog
POSTHOG_API_KEY=

# Lovable AI (optional — only if you keep AI features)
LOVABLE_API_KEY=
